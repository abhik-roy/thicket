# Copy to .env and fill in, then: `set -a; source .env; set +a`

# --- ScrapeBadger (default source) ---
SCRAPEBADGER_API_KEY=sb_live_xxxxxxxxxxxxx

# --- Reddit OAuth (only if source: reddit; requires API pre-approval as of Nov 2025) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional — enables the higher-limit script "password" grant:
REDDIT_USERNAME=
REDDIT_PASSWORD=
